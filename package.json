{
  "name": "harvesthex",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HARVESTHEX: grow something dangerous. A farming bullet-hell action RPG for the browser.",
  "scripts": {
    "dev": "vite --port 5177",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4177",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "art": "vite-node tools/art-preview.ts",
    "balance": "vite-node tools/balance-sim.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/jacquard-24": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/jersey-15": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "phaser": "^4.2.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
